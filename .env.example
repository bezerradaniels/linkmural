# Copie para .env.local (dev) e cadastre as mesmas chaves na Hostinger. Nunca envie .env* para o GitHub.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000          # produção: https://linkmural.com
NEXT_PUBLIC_ROOT_HOSTS=localhost:3000,linkmural.com,www.linkmural.com

# Supabase (Project Settings → API). A chave publishable pode ir para o navegador;
# nunca coloque a secret/service_role key em variáveis NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=                          # só no servidor; nunca em componente client

# Stripe (modo de teste primeiro)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# E-mail (Resend)
RESEND_API_KEY=
EMAIL_FROM="Linkmural <oi@linkmural.com>"

# Opcionais
GOOGLE_SAFE_BROWSING_KEY=                           # checagem de links perigosos
CLOUDFLARE_API_TOKEN=                               # domínios próprios (fase Negócios)
CLOUDFLARE_ZONE_ID=
REVALIDATE_SECRET=                                  # para revalidar páginas a partir do Supabase
